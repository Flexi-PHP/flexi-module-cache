{
  "name": "flexi/flexi-module-cache",
  "description": "Cache module for Flexi Framework with File and InMemory implementations",
  "version": "2.0.0",
  "type": "flexi-module",
  "license": "MIT",
  "keywords": [
    "flexi",
    "module",
    "cache",
    "psr-16",
    "file-cache",
    "memory-cache"
  ],
  "authors": [
    {
      "name": "Carlos Batista",
      "email": "info@carlosbatista.dev",
      "homepage": "https://carlosbatista.dev"
    }
  ],
  "require": {
    "php": ">=7.4",
    "flexi/contracts": "^5.2.1",
    "psr/cache": "^1.0",
    "psr/container": "^2.0",
    "psr/simple-cache": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Flexi\\Modules\\Cache\\": ""
    }
  },
  "extra": {
    "flexi": {
      "module-name": "Cache",
      "module-type": "infrastructure",
      "config-files": [
        "Config/services.json"
      ],
      "provides": [
        "cache",
        "file-cache",
        "memory-cache"
      ],
      "schema-version": 1,
      "compatibility": {
        "core": "^3.2"
      }
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Flexi\\Modules\\Cache\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  }
}
